{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "tali-sms",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-22",
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "tali",
			"database_id": "b3df3b91-e013-4ae7-b9cc-7ba02e4c02b8"
		}
	],
	"vars": {
		"APPLE_CLIENT_ID": "com.kathrynswint.Tali",
		"OWNER_TIME_ZONE": "America/Los_Angeles",
		"ALLOW_UNSIGNED_TWILIO": "false"
	},
	"triggers": {
		"crons": ["17 8 * * *"]
	}
}
